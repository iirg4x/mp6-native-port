+static char mp6_micquiz_insert_text_storage[4][HUWIN_INSERTMES_MAX][32];
+static void mp6_micquiz_insert_text(s32 windowNo, const char *text, s16 insertNo)
+{
+    char *slot;
+
+    if (windowNo < 0 || windowNo >= 4 || insertNo < 0 || insertNo >= HUWIN_INSERTMES_MAX)
+        return;
+    slot = mp6_micquiz_insert_text_storage[windowNo][insertNo];
+    strncpy(slot, text, sizeof(mp6_micquiz_insert_text_storage[0][0]) - 1);
+    slot[sizeof(mp6_micquiz_insert_text_storage[0][0]) - 1] = 0;
+    mp6_window_insert_text(fn_1_206FC(windowNo), slot, insertNo);
