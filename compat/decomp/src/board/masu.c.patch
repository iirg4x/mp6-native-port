+/* Test-only: MP6_TEST_HATENA_ATTR=<mask> runs a ? space event as if on the
+ * next space (cycling the board) whose attributes match mask, with the
+ * player moved there first. Boards pick their ? event from the space's
+ * attributes, so a forced run reaches each event kind on demand. */
+static s16 mp6_test_hatena_masu(int playerNo, s16 id)
+{
+    static int cursor;
+    const char *env = getenv("MP6_TEST_HATENA_ATTR");
+    u32 mask = env && *env ? strtoul(env, NULL, 0) : 0;
+    int spaces = mbMasuNumGet() - 1;
+    HuVecF pos;
+
+    for (int step = 1; mask && step <= spaces; step++) {
+        s16 next = (s16)((cursor + step - 1) % spaces + 1);
+        if (mbMasuMAttrGet(next) & mask) {
+            cursor = next;
+            GwPlayer[playerNo].masuId = next;
+            mbMasuPosGet(next, &pos);
+            mbPlayerPosSetV(playerNo, &pos);
+            OSReport("[TEST] hatena space=%d attr=0x%x player=%d\n", next,
+                     (unsigned)mbMasuMAttrGet(next), playerNo);
+            return next;
+        }
+    }
+    return id;
+}
