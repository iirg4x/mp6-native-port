+/* ---------------------------------------------------------------------
+ * Widescreen: anchor the board status layer to the TRUE screen edges.
+ *
+ * game/sprput.c's HuSprDispInit recenters the ONE shared 2D ortho to
+ * [-d, HU_DISP_WIDTH+d] where d = mp6_widescreen_half_width_delta()
+ * for the whole 2D layer at once -- so the native 0..576 logical canvas
+ * lands in the MIDDLE of a wide frame and every 2D element keeps its
+ * native relative layout with no per-element shim at all. That is exactly
+ * right for content composed as one centered picture, and exactly wrong
+ * for a HUD element whose whole design intent is "sit N units in from the
+ * screen's OWN corner": statusPosOn/statusPosOff (and their team
+ * variants) are authored at 114 / HU_DISP_WIDTH-114 precisely because
+ * those are corner insets, so under the recentered ortho all four panels
+ * float d logical units INSIDE the true left/right edges instead of
+ * hugging them -- growing with the aspect, ~104 units at 16:9 and ~223 at
+ * 21:9.
+ *
+ * These two helpers move exactly those elements back out to the real
+ * edges. The status layer stays entirely in NATIVE (576-space)
+ * coordinates end to end -- the tables, posBegin/posEnd, and every public
+ * getter (mbStatusPosOnGet/mbStatusPosOffGet still hand out native
+ * values, so board/capevent.c's own duel framing is unaffected) -- and
+ * the anchor is applied at the ONE place a position is actually handed to
+ * a sprite group, and inverted at the one place a position is read back
+ * out of one. Nothing can be shifted zero, one or two times depending on
+ * which call path it took: the same single-point discipline already
+ * established for the ortho itself, applied one layer down.
+ *
+ * HU_DISP_WIDTH is NOT redefined and the retail 10/9 X mapping is
+ * untouched: the ortho's logical span (576*k) and the render width
+ * (640*k) grow by the same factor, so a 114-unit inset stays the same
+ * physical proportion of the frame at every aspect.
+ *
+ * The side test is unambiguous in BOTH spaces -- every left-side status X
+ * this file can produce is <= 140 and every right-side one is >= 436,
+ * native or anchored (d >= 0 only pushes them further apart) -- so
+ * StatusUnanchorX is an exact inverse of StatusAnchorX. Both are exact
+ * no-ops when widescreen is disabled (d is 0.0f), so a default-OFF build
+ * makes byte-identical calls with byte-identical arguments.
+ * --------------------------------------------------------------------- */
+static float StatusAnchorX(float x)
+{
+    float d = mp6_widescreen_half_width_delta();
+    return (x < HU_DISP_CENTERX) ? (x - d) : (x + d);
+}
+
+static float StatusUnanchorX(float x)
+{
+    float d = mp6_widescreen_half_width_delta();
+    return (x < HU_DISP_CENTERX) ? (x + d) : (x - d);
+}
+
+/* Panel-identity diagnostics (port-only, MP6_STATUS_DIAG=1). The four
+ * panels' faces are baked at StatusSprCreate time from
+ * GwPlayerConf[slot].charNo, while everything else on the panel (rank,
+ * coins, the CPU badge) is read live from GwPlayer[slot] every frame -- so
+ * a face that disagrees with the rest of its own panel is the signature of
+ * a rebuild that did not take. Zero cost and zero output when the variable
+ * is unset, matching MP6_WS_HSF_DIAG's own always-compiled-in precedent. */
+static int StatusDiagOn(void)
+{
+    static int on = -1;
+    if(on < 0) {
+        const char *e = getenv("MP6_STATUS_DIAG");
+        on = (e != NULL && e[0] != '\0' && e[0] != '0') ? 1 : 0;
+    }
+    return on;
+}
+
+static unsigned long StatusDiagHash(const void *p, int len)
+{
+    const unsigned char *b = (const unsigned char *)p;
+    unsigned long h = 2166136261UL;
+    int i;
+    if(b == NULL || len <= 0) {
+        return 0;
+    }
+    for(i=0; i<len; i++) {
+        h ^= (unsigned long)b[i];
+        h = (h * 16777619UL) & 0xFFFFFFFFUL;
+    }
+    return h;
+}
+
+/* The EXACT window aurora's own GXInitTexObj content fingerprint uses
+ * (lib/dolphin/gx/GXTexture.cpp, mp6-port patch 0006): first 64 bytes +
+ * last 64 bytes + the byte count. Printed alongside a full-buffer hash so
+ * a "different content, identical fingerprint" collision -- which would
+ * make the renderer's static-texture cache serve a stale image for a
+ * freshly-loaded texture at a recycled address -- is visible directly in
+ * the log instead of being inferred. */
+static unsigned long StatusDiagHeadTailHash(const void *p, int len)
+{
+    const unsigned char *b = (const unsigned char *)p;
+    unsigned char scratch[136];
+    int n = 0;
+    int headLen;
+    if(b == NULL || len <= 0) {
+        return 0;
+    }
+    headLen = (len < 64) ? len : 64;
+    memcpy(scratch, b, headLen);
+    n = headLen;
+    if(len > headLen) {
+        int tailLen = ((len - headLen) < 64) ? (len - headLen) : 64;
+        memcpy(scratch + n, b + (len - tailLen), tailLen);
+        n += tailLen;
+    }
+    memcpy(scratch + n, &len, sizeof(len));
+    n += (int)sizeof(len);
+    return StatusDiagHash(scratch, n);
+}
