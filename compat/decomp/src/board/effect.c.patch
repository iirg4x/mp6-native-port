+/* omObjGetWork() aliases FADEEFFWORK onto OMOBJ::work[4] and OMOBJ::data
+ * sits immediately after it, so overflowing work[] silently turns a
+ * member write into a corrupted heap pointer.  Fail the build instead. */
+_Static_assert(sizeof(FADEEFFWORK) <= sizeof(((OMOBJ *)0)->work),
+               "FADEEFFWORK overflows OMOBJ::work[4] -- omObjGetWork aliases "
+               "it there and the next member is the pointer omDelObjEx frees");
