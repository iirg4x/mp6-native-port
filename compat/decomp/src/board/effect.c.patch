+    /* HOST ABI -- bit-field storage unit, not a behaviour change.
+     *
+     * This struct is never allocated: FadeOMExec and friends reach it
+     * through omObjGetWork(obj, FADEEFFWORK), which game/object.h defines
+     * as a plain cast onto OMOBJ's inline `u32 work[4]` -- 16 bytes, with
+     * `void *data` as the very next member.  Declared `unsigned`, the two
+     * flags claim a whole 4-byte unit under this compiler and push `alpha`
+     * to offset 4, which makes the struct 20 bytes: `speed` then lands ON
+     * obj->data.  omDelObjEx frees obj->data when it tears the object
+     * down, so closing the board pause menu handed the allocator the bit
+     * pattern of a float -- "misaligned address 0xc0aaaa83 for type
+     * 'MEMORY_BLOCK'", 0xc0aaaa83 being -5.3333f, the fade's own speed.
+     *
+     * `u8` puts the flags in a 1-byte unit, `alpha` back at offset 1, and
+     * the struct back to exactly 16 bytes -- which is the size the
+     * recovered source was written against, since anything larger would
+     * have corrupted obj->data on real hardware too.  The assert below
+     * makes the constraint explicit instead of implicit. */
+    u8 killF : 1;
+    u8 pauseF : 1;
+    u8 targetAlpha;
+    s16 time;
+    s16 maxTime;
