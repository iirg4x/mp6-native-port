+void mp6_board_window_insert_text(s16 winNo, const char *text, int slot)
+{
+    if (!mbWinData || winNo < 0 || winNo >= MBWIN_MAX ||
+        slot < 0 || slot >= HUWIN_INSERTMES_MAX) return;
+    MBWIN *window = &mbWinData[winNo];
+    window->insertMes[slot] = MBWIN_MES_NONE;
+    window->insertText[slot] = text;
+    if (window->winId >= 0) mp6_window_insert_text(window->winId, text, slot);
+}
+
+void mp6_board_window_top_insert_text(const char *text, int slot)
+{
+    if (mbWinTopNo) mp6_board_window_insert_text(mbWinStack[mbWinTopNo - 1], text, slot);
+}
