+/* Keep the description carousel's parked panels beyond the visible canvas.
+ * The base positions and movement retain their native 576-unit coordinates;
+ * only their displacement from the selected panel grows with the live aspect.
+ * Re-evaluating at draw-position updates also handles an open-shop resize. */
+static void ev_ShopDescPosSet(int winId, const HuVecF *basePos, float moveX, int slot)
+{
+    float offset = SHOP_SELECT_WINDOW_SPACING * slot + moveX;
+    float x = basePos->x + moveX;
+    x += offset * (mp6_widescreen_scale_factor() - 1.0f);
+    mbWinPosSet(winId, x, basePos->y);
+}
