-// The Hu3D draw hook uses the board image's alpha as a black mask and fills its outside region.
+static float WipeCircleHalfSize(float size)
+{
+    float halfSize = 0.5f * size;
+    float delta = mp6_widescreen_half_width_delta();
+    if (delta > 0.0f) {
+        float halfWidth = 288.0f + delta;
+        /* Keep the native corner-clearance timing with a circular, not
+         * horizontally stretched, iris on wider canvases. */
+        halfSize *= (float)sqrt((halfWidth * halfWidth + 240.0f * 240.0f) /
+                               (288.0f * 288.0f + 240.0f * 240.0f));
+    }
+    return halfSize;
+}
