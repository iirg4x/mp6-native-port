+/* Widescreen, view only: players wait for the intro just outside the native
+ * 4:3 frame, which a wide frame shows. Draw each one from outside the wide
+ * frame instead, converging on its real position as it walks to its first
+ * mark. The actor's position, walk, timing and arrival barrier stay native,
+ * so the game plays out exactly as at 4:3. */
+static void mp6_m675_entrance_view(M675PlayerWork *work, s32 model)
+{
+    Vec shown = work->actor.position;
+    s32 slot = work->actor.formationIndex;
+    float k = mp6_widescreen_scale_factor();
+    fn_1_74FC(&work->actor, model);
+    if (k <= 1.0f || work->processPhase != 0 || work->phase > 2 || slot < 0 || slot >= 4)
+        return;
+    float start = lbl_1_data_1A8[slot].x, mark = lbl_1_data_1E8[slot].x;
+    float f = (shown.x - mark) / (start - mark);
+    if (f <= 0.0f) return;
+    shown.x += (f < 1.0f ? f : 1.0f) * (k - 1.0f) * start;
+    Hu3DModelPosSetV((s16)model, &shown);
+}
