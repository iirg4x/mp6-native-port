+static void BootTitleAOPreDrawHook(s16 layerNo)
+{
+    (void)layerNo;
+    /* BootTitleExec's PARTY/SIX/STAR HSFs are a flat authored collage.  The
+     * hook runs before layer 0 of camera 1, so this segment is excluded
+     * before any title depth can reach AO; actual opening book geometry on
+     * layer 1 becomes eligible again after OpeningExec installs PreDrawHook
+     * and the normal depth epochs are rebuilt. */
+    mp6_ao_camera_exclude(Hu3DCameraNo);
+}
