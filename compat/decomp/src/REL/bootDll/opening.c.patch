--- a/src/REL/bootDll/opening.c
+++ b/src/REL/bootDll/opening.c
@@ -16,0 +17,2 @@
+#include "mp6_widescreen.h" /* widescreen support */
+#include "mp6_ambient_occlusion.h" /* authored page artwork is not scene geometry */
@@ -165,0 +168 @@
+    mp6_widescreen_extrude_model(OpeningMdlId[0]);
@@ -543,0 +547,6 @@
+    /* The character cutouts are painted page content captured by PostDrawHook.
