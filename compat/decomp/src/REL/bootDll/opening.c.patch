+     * starts a new eligible segment for the actual 3D book on layer 1. */
+    mp6_ao_camera_exclude(Hu3DCameraNo);
+    /* Page contents target the authored 640x320 texture, not the window. */
+    mp6_widescreen_camera_native_target(OPENING_CAMERA_BIT, 1);
@@ -559,0 +569,2 @@
+    /* The book and scene around it are on-screen, unlike the page capture. */
+    mp6_widescreen_camera_native_target(OPENING_CAMERA_BIT, 0);
