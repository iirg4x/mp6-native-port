+#include "game/hu3d.h"
+/* The garden stage is the prop whose HSF carries the outer grass. */
+static int mp6_m620_is_garden(s16 model)
+{
+    HSF_DATA *hsf = Hu3DData[model].hsf;
+    s32 i;
+
+    for (i = 0; hsf != NULL && i < hsf->objectNum; i++) {
+        if (hsf->object[i].name != NULL && strcmp(hsf->object[i].name, "gro_out_a") == 0) {
+            return 1;
+        }
+    }
+    return 0;
+}
+
+/* Continue one outer ground piece's flat grass (local y = 0) away from the
+ * arena centre, which is the world origin seen from the piece's frame. */
+static void mp6_m620_extend_ground(s16 model, const char *name)
+{
+    HSF_DATA *hsf = Hu3DData[model].hsf;
+    s32 i;
+
+    for (i = 0; i < hsf->objectNum; i++) {
+        HSF_OBJECT *object = &hsf->object[i];
+        if (object->name != NULL && strcmp(object->name, name) == 0) {
+            f32 angle = -object->mesh.base.rot.y * 3.14159265f / 180.0f;
+            f32 x = -object->mesh.base.pos.x, z = -object->mesh.base.pos.z;
+            mp6_widescreen_extend_floor_at(model, name, 0, 0.0f, x * cosf(angle) + z * sinf(angle),
+                                           -x * sinf(angle) + z * cosf(angle), 4.0f);
+            mp6_widescreen_extend_terrain_sides(model, name, x * cosf(angle) + z * sinf(angle), 1);
+            mp6_widescreen_extend_terrain_outer_sides(model, name, x * cosf(angle) + z * sinf(angle), 2.0f, 1);
+            return;
+        }
+    }
+}
