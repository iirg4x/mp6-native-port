@@ -204,0 +207,23 @@
+#include "game/hu3d.h"
+/* Widescreen: the opening shot frames the whole sky box, whose sky panel
+ * and brick stage end at the 4:3 edge. Widen the sky and continue the stage
+ * sides; the play area is unchanged. */
+static void mp6_m642_widen_scenery(s16 model)
+{
+    HSF_DATA *hsf = Hu3DData[model].hsf;
+    s32 i;
+
+    for (i = 0; hsf != NULL && i < hsf->objectNum; i++) {
+        const char *name = hsf->object[i].name;
+        if (name == NULL) {
+            continue;
+        }
+        if (strcmp(name, "642sky") == 0 || strcmp(name, "642sky1") == 0) {
+            mp6_widescreen_scale_backdrop(model, name, 1);
+        } else if (strcmp(name, "642stage") == 0) {
+            mp6_widescreen_extend_terrain_outer_sides(model, name, 0.0f, 2.0f, 1);
+            mp6_widescreen_extend_wall_outer_sides(model, name, 0.0f, 2.0f, 1);
+        }
+    }
+}
