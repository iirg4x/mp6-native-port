-/* Object-create callback that builds each score panel and its display sprites. */
+static void mp6_m657_score_positions(M657ScoreWork *work)
+{
+    float shift = 0.5f * mp6_widescreen_half_width_delta();
+    for (int team = 0; team < 2; ++team) {
+        M657ScoreTeam *score = &work->teams[team];
+        float x = lbl_1_data_1E8[team].x + (team ? shift : -shift);
+        float y = lbl_1_data_1E8[team].y;
+        MgScoreBoxPosSet(score->box, x, y);
+        MgScorePosSet(score->seconds, x - 32.0f, y);
+        MgScorePosSet(score->hundredths, x + 16.0f, y);
+        HuSprGrpPosSet(score->separator, x, y);
+    }
+}
