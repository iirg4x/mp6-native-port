+static void mp6_m638_prompt_positions(M638SceneView *scene)
+{
+    float margin = mp6_widescreen_half_width_delta();
+    for (int i = 0; i < 5; ++i) {
+        /* Keep each team's callouts on its outside edge, not over its actors.
+         * Re-derive from native positions so resizing never accumulates. */
+        espPosSet(scene->teams[0].sprites[i], 50.0f - margin, 150.0f);
+        espPosSet(scene->teams[1].sprites[i], 526.0f + margin, 150.0f);
+    }
+}
