+            HSF_DATA *hsf = Hu3DData[model].hsf;
+            s32 objectIndex;
+            /* DK's plaza (and its underwater wall) runs off the 4:3 frame
+             * along local +X and simply stops at x=600; continue it into its
+             * mirror image so a wide view never sees the cut. */
+            mp6_widescreen_mirror_mesh(model, "cyl21", 0, 0, 600.0f);
+            /* The prop clip owns these positions, so widen its X keys.
+             * Shadows scale about the centred camera. A frond hangs
+             * inward from its pivot, so its visible blade sits nearer
+             * the centre: widen about a pivot partway out instead. */
+            for (objectIndex = 0; objectIndex < hsf->objectNum; objectIndex++) {
+                HSF_OBJECT *frond = &hsf->object[objectIndex];
+                if (frond->name != NULL && mp6_m674_frame_frond(frond->name)) {
+                    mp6_widescreen_motion_x(model, frond->name,
+                        frond->name[0] == 'h' ? MP6_M674_FROND_PIVOT * frond->mesh.base.pos.x : 0.0f);
+                }
+            }
+        }
