@@ -15,0 +16,14 @@
+#include "mp6_widescreen.h"
+
+#define MP6_M674_FROND_PIVOT 0.35f
+
+static int mp6_m674_frame_frond(const char *name)
+{
+    const char *digits = name[0] == 'h' && name[1] == 'a' ? name + 2
+        : name[0] == 'y' && name[1] == 'a' && name[2] == 's' && name[3] == 'i'
+            && name[4] == '_' && name[5] == 'K' ? name + 6 : NULL;
+    if (digits == NULL || *digits == '\0') return 0;
+    for (; *digits; ++digits) if (*digits < '0' || *digits > '9') return 0;
+    return 1;
+}
+void fn_1_1218(s32 modelId, char *lightName);
