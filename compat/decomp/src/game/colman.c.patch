+/* MP6_GAMEPLAY_TRACE (src/os/gameplay_trace.c): folds the collision world
+ * the minigame plays in -- each mesh's bounds (built from its vertices at
+ * ColMapInit), its live transform, and every body's position -- into an
+ * FNV-1a hash. A view-only feature must leave this identical. */
+static u32 mp6ColHashFloats(u32 hash, const float *values, int count)
+{
+    while (count-- > 0) {
+        u32 bits;
+        memcpy(&bits, values++, sizeof(bits));
+        for (int i = 0; i < 4; ++i, bits >>= 8) hash = (hash ^ (bits & 0xFF)) * 16777619u;
+    }
+    return hash;
+}
+
+u32 mp6_colman_state_hash(u32 hash)
+{
+    COLMESH *meshP;
+    int no;
+    if (!colMapInitF || colMesh == NULL || colWork.body == NULL) return hash;
+    for (meshP = colMesh, no = colMeshCount; no--; meshP++) {
+        hash = mp6ColHashFloats(hash, &meshP->boundsCenter.x, 4);
+        hash = mp6ColHashFloats(hash, &meshP->mtx[0][0], 12);
+    }
+    for (no = 0; no < colWork.bodyNum; ++no) {
+        COLBODY *bodyP = &colWork.body[no];
+        hash = mp6ColHashFloats(hash, &bodyP->pos[0].x, 6);
+        hash = mp6ColHashFloats(hash, &bodyP->oldPos.x, 3);
+    }
+    return hash;
+}
