+#include "mp6_widescreen.h" /* widescreen support */
+
+/* Screen coverage and texture storage are separate coordinate domains. */
+static void WipeCaptureFrame(void *image)
+{
+    GXSetTexCopySrc(0, 0, mp6_widescreen_render_width(), HU_FB_HEIGHT);
+    GXSetTexCopyDst(HU_FB_WIDTH/2, HU_FB_HEIGHT/2, GX_TF_RGB565, GX_TRUE);
+    GXCopyTex(image, GX_FALSE);
+    GXPixModeSync();
+}
@@ -23,0 +34,16 @@
+/* Retail ANMs were one in-place allocation; native ANMs own a decoded graph
+ * and a packed backing allocation. Release both through the sprite owner. */
+static void WipeImageRelease(int index)
+{
+    void *image = wipeData.image[index];
+    int type = wipeData.type & WIPE_TYPE_MASK;
+    if (!image) return;
+    if (index == 1 || type == WIPE_TYPE_STAR || type == WIPE_TYPE_KOOPA ||
+        type == WIPE_TYPE_MOON || type == WIPE_TYPE_SUN || type == WIPE_TYPE_SUNMOON) {
+        HuSprAnimKill(image);
+    } else {
+        HuMemDirectFree(image);
+    }
+    wipeData.image[index] = NULL;
+}
