+#include "mp6_widescreen.h" /* widescreen support */
+#include <stdio.h>  /* object census (see HuSprTexLoad below) */
+#include <stdlib.h>
+#include <math.h>
+
+static void mp6SprScissorSet(HUSPRITE *sp)
+{
+    if (!mp6_widescreen_enabled()) {
+        GXSetScissor(sp->scissorX, sp->scissorY, sp->scissorW, sp->scissorH);
+        return;
+    }
+    int width = mp6_widescreen_render_width();
+    if (!sp->scissorX && !sp->scissorY &&
+        sp->scissorW == HU_FB_WIDTH && sp->scissorH == HU_FB_HEIGHT) {
+        GXSetScissor(0, 0, width, HU_FB_HEIGHT);
+        return;
+    }
+    if (sp->scissorW <= 0 || sp->scissorH <= 0) {
+        GXSetScissor(0, 0, 0, 0);
+        return;
+    }
+    /* Custom rectangles (results statistics) are in native framebuffer,
+     * not 576-wide HUD units. Translate with the centred sprite projection;
+     * do not widen the rectangle or discard its content clipping. */
+    float dx = 0.5f * (width - HU_FB_WIDTH);
+    int x0 = (int)floorf(sp->scissorX + dx);
+    int x1 = (int)ceilf(sp->scissorX + sp->scissorW + dx);
+    int y0 = sp->scissorY, y1 = sp->scissorY + sp->scissorH;
+    if (x0 < 0) x0 = 0;
+    if (x0 > width) x0 = width;
+    if (x1 > width) x1 = width;
+    if (y0 < 0) y0 = 0;
+    if (y0 > HU_FB_HEIGHT) y0 = HU_FB_HEIGHT;
+    if (y1 > HU_FB_HEIGHT) y1 = HU_FB_HEIGHT;
+    GXSetScissor(x0, y0, x1 > x0 ? x1-x0 : 0, y1 > y0 ? y1-y0 : 0);
+}
