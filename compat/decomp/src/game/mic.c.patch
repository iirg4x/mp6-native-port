+/* MP6 native port: OS threads are not scheduled here, so MCThreadFunc never
+ * runs. Its command loop runs synchronously instead: a command does what the
+ * thread would have done on receiving it (start or stop the engine, so a
+ * caller's following OSSleepThread has nothing left to wait for), and
+ * MCThreadStep is the loop's per-pass body without a new command. */
+static void MCThreadStep(void)
+{
+  s32 micMode;
+
+  if (HuMCSelWinCheck() || (micMode = GwCommon.mic, micMode != 1) || (MCSprStat == 4)) {
+    return;
+  }
+  if ((MicOpenF != 0) && (MCSprStat != 2)) {
+    if (MCSprStat == 1) {
+      MCSprStat = 2;
+    }
+    else {
+      MCSprStat = 3;
+    }
+  }
+  switch (MCSprStat) {
+    case 0:
+      MC_gsapiEngineError = gsapi_EngineStart(MC_gsapiEngine);
+      MCSprStat = (MC_gsapiEngineError < 0) ? 4 : 1;
+      break;
+    case 1:
+      gsapi_EngineRestart(0);
+      break;
+    case 2:
+      MC_gsapiEngineError = gsapi_EngineStop(MC_gsapiEngine);
+      MCSprStat = (MC_gsapiEngineError < 0) ? 4 : 3;
+      break;
+  }
+}
+
+static void MCThreadCommand(s32 command)
+{
+  MCSprStat = command;
+  MCThreadStep();
+}
