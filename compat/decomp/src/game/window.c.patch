+void HuWinMesSet(HUWINID winId, u32 messNum)
+{
+    HUWIN *winP = &winData[winId];
+    winP->stat = HUWIN_STAT_DRAWMES;
+    mp6QuickMustRead[winId] = mp6_quick_play_must_read(messNum);
+    mp6QuickAction[winId] = 0;
+    if(messNum < MP6_MESSNUM_ENCODED_MAX) {
+        if(!messDataPtr) {
+            OSReport("Error: No Message\n");
+            return;
+        }
+        winP->messData = HuWinMesPtrGet(messNum);
+        if(!winP->messData) {
+            OSReport("Error: No Message data\n");
+        }
+    } else {
+        winP->messData = (void *)messNum;
+    }
+    mp6_window_finish_message(winId, messNum);
+}
+
+void mp6_window_set_text(HUWINID winId, const char *text)
+{
+    if (winId < 0 || winId >= HUWIN_MAX || !text) return;
+    winData[winId].stat = HUWIN_STAT_DRAWMES;
+    winData[winId].messData = (char *)text;
+    mp6QuickMustRead[winId] = 0;
+    mp6QuickAction[winId] = 0;
+    mp6_window_finish_message(winId, 0);
+}
