+/* [MP6] Quick Party (include/mp6_quick_play.h): on sped-up scenes a
+ * "press A to continue" pause dismisses itself after a short glance, as if
+ * every player allowed on the window had pressed its push key. Questions
+ * (choice state) are never answered for the player. Ticks waited so far: */
+static s16 mp6QuickKeyWaitTime[HUWIN_MAX];
+/* Set when the window's message states what is at stake: that page waits
+ * for a person's press (mp6_quick_play_must_read). */
+static u8 mp6QuickMustRead[HUWIN_MAX];
+/* Set by mp6_window_quick_action_set: a live action prompt. */
+static u8 mp6QuickAction[HUWIN_MAX];
+
+void mp6_window_quick_action_set(HUWINID winId)
+{
+    if (winId >= 0 && winId < HUWIN_MAX) mp6QuickAction[winId] = 1;
+}
+
+/* A computer's pause already has its press scripted in the shared queue
+ * (board/window.c KeyWaitSet: a delay, then A, per page). Take that press
+ * now instead of adding one: left queued, it answers whichever window
+ * polls next. A stale A then picked the first entry of the following
+ * choice, and that choice's own scripted cursor keys spilled into the menu
+ * after it -- on a Duel space they reached the wager menu's "Back", which
+ * reopens the opponent list, round after round. Returns FALSE when nothing
+ * is queued (a person's window). */
+static BOOL mp6_quick_play_take_com_press(void)
+{
+    while (comKeyIdxNow != comKeyIdx) {
+        WINCOMKEY *entry = &winComKeyBuf[comKeyIdxNow];
+        u32 press = 0;
+        s16 i;
+        comKeyIdxNow = (comKeyIdxNow + 1) & 255;
+        for (i = 0; i < GW_PLAYER_MAX; i++) {
+            if (entry->controllerKey[i] != HUWIN_COMKEY_NONE) {
+                press |= entry->controllerKey[i];
+                winKey[i] |= entry->controllerKey[i];
+            }
+        }
+        if (press) {
+            return TRUE;
+        }
+    }
+    return FALSE;
+}
+
+static void mp6_quick_play_keywait(HUWINID winId, HUWIN *winP)
+{
+    u32 key;
+    s16 i;
+    if (mp6QuickMustRead[winId] && mp6_quick_play_scene() && mp6_quick_play_human_present()) {
+        /* Everyone should read what is at stake, so only a person's press
+         * ends it: drop the computer's scripted press and take the live
+         * pads, even on a computer's turn (whose windows shut people out;
+         * computers' pads stay idle). */
+        comKeyIdxNow = comKeyIdx;
+        for (i = 0; i < GW_PLAYER_MAX; i++) {
+            winKey[i] = HuPadDStkRep[i] | HuPadBtnDown[i];
+        }
+        mp6_quick_play_hold("stakes line");
+        return;
+    }
+    if (!mp6_quick_play_scene() ||
+        ++mp6QuickKeyWaitTime[winId] < mp6_quick_play_keywait_ticks() ||
+        (HuWinActivePadGet(winP) & winP->pushKey)) {
+        return;
+    }
+    if (mp6_quick_play_take_com_press()) {
+        return;
+    }
+    /* One key, preferring A: callers may read which key ended the wait. */
+    key = (winP->pushKey & PAD_BUTTON_A) ? PAD_BUTTON_A
+                                         : (winP->pushKey & (0u - (u32)winP->pushKey));
+    for (i = 0; i < GW_PLAYER_MAX; i++) {
+        if (winP->padMask & (1 << i)) {
+            winKey[i] |= key;
+        }
+    }
+}
