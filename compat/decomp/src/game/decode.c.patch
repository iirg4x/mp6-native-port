--- a/src/game/decode.c
+++ b/src/game/decode.c
@@ -5,0 +6,3 @@
+#include "be.h"
+#include "mp6_load_trace.h"
+#include "mp6_decode_ahead.h"
@@ -205,2 +207,0 @@
-// Resource loaders call this with packed source data and a destination buffer sized for the decoded
-// resource.
@@ -210,0 +212 @@
+    uint64_t mp6TraceStart;
@@ -213,0 +216,6 @@
+    mp6TraceStart = mp6_load_trace_begin(); /* MP6_LOAD_TRACE: decompression time */
+    if (mp6_decode_ahead_take(src, dst, size, decodeType)) { /* decoded by a worker */
+        mp6_load_trace_end(mp6TraceStart, MP6_LOAD_DECODE, size);
+        DCFlushRange(dst, size);
+        return;
+    }
@@ -249 +257,4 @@
-    // Write back the requested cache range even when the type is unknown.
+    mp6_load_trace_end(mp6TraceStart, MP6_LOAD_DECODE, size);
+    mp6_decode_ahead_verify(dst, size);
+    /* MP6_DECODE_GUARD=1 (include/mp6_decode_ahead.h); dst-advancing decoders only. */
+    mp6_decode_guard(dst, size, decodeType, (long long)(decodeState->dst - (u8 *)dst), decodeState->size);
@@ -277 +288 @@
-    stream.avail_in = compressedWords[1];
+    stream.avail_in = be32(&compressedWords[1]);
@@ -281,2 +292 @@
-    // The output limit is set from this local's address rather than decode->size.
-    stream.avail_out = (uInt)(&outputLimitStorage);
+    stream.avail_out = decode->size;
@@ -290 +300,8 @@
-    // Any non-stream-end result ends the stream; a Z_OK result is reported as Z_BUF_ERROR.
+#ifdef MP6_ZLIB_DEBUG_DUMP
+    {
+        u8 *d = (u8 *)decode->dst;
+        OSReport("[ZLIB] result=%d total_out=%lu avail_in_left=%u dst[0..7]=%02x %02x %02x %02x %02x %02x %02x %02x\n",
+                  zlibResult, stream.total_out, stream.avail_in,
+                  d[0], d[1], d[2], d[3], d[4], d[5], d[6], d[7]);
+    }
+#endif
