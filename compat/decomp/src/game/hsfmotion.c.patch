+/* MP6: SearchObjectIndex compares a track's name with every object name in
+ * turn, and a board start attaches thousands of motions (tracks x objects
+ * strcmp calls, several ms). JointModel_Motion indexes the object names
+ * once per call instead (include/mp6_name_index.h); same first match. */
+#include <stddef.h>
+#include "mp6_name_index.h"
+static Mp6NameIndex mp6ObjIndex;
+static HSF_DATA *mp6ObjIndexHsf;
+
+static s32 mp6SearchObjectIndexed(HSF_DATA *hsf, u32 nameOffset)
+{
+    if (hsf != mp6ObjIndexHsf || !mp6ObjIndex.slot) return SearchObjectIndex(hsf, nameOffset);
+    return mp6_name_index_find(&mp6ObjIndex, SetName(&nameOffset));
