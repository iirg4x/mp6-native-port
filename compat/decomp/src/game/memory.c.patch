+/* MP6_NATIVE_PORT: first-fit without the GameCube-era linear walk -- each
+ * heap keeps an address-sorted index of its free blocks (port code, see
+ * include/mp6_heap_index.h); allocation takes the first indexed block that
+ * fits, which is the block the original walk returns. */
+#include <stdlib.h>
+#include <stdio.h>
+#include "mp6_heap_index.h"
+
+typedef Mp6HeapIndex MP6_HEAP_INDEX;
+#define mp6HeapIndexVerify mp6_heap_index_verify
+#define mp6HeapIndexFind mp6_heap_index_find
+#define mp6HeapIndexOwner mp6_heap_index_owner
+#define mp6HeapIndexDropRange mp6_heap_index_drop_range
+#define mp6HeapIndexInsert mp6_heap_index_insert
+#define mp6HeapIndexRemove mp6_heap_index_remove
+#define mp6HeapIndexRegister mp6_heap_index_register
+
+/* MP6_HEAP_HINT_VERIFY: the index must list exactly the heap's free blocks. */
+static void mp6HeapIndexCheck(MP6_HEAP_INDEX *entry)
+{
+    MEMORY_BLOCK *block;
+    s32 n = 0;
+    if(entry == NULL || !entry->indexed || !mp6HeapIndexVerify()) {
+        return;
+    }
+    block = (MEMORY_BLOCK *)entry->head;
+    do {
+        if(!block->isAllocated) {
+            if(n >= entry->freeCount || entry->freeBlocks[n] != block) {
+                OSReport("[MP6-HEAP] free index mismatch heap=%p block=%p slot=%d\n",
+                         entry->head, block, n);
+                abort();
+            }
+            n++;
+        }
+        block = block->next;
+    } while(block != entry->head);
+    if(n != entry->freeCount) {
+        OSReport("[MP6-HEAP] free index has %d stale entries heap=%p\n", entry->freeCount - n,
+                 entry->head);
+        abort();
+    }
+}
+
+/* The original first-fit search, used only by MP6_HEAP_HINT_VERIFY. */
+static MEMORY_BLOCK *mp6HeapFirstFitReference(void *heapHead, s32 alignedSpanBytes)
+{
+    MEMORY_BLOCK *block = heapHead;
+    do {
+        if(!block->isAllocated && block->spanBytes >= alignedSpanBytes) {
+            return block;
+        }
+        block = block->next;
+    } while(block != heapHead);
+    return NULL;
+}
