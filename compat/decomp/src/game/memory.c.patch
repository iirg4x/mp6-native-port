+/* MP6_NATIVE_PORT (MP6_HEAP_CHECK=1, src/os/load_trace.c): walk one heap's
+ * block list without trusting it and describe the first broken header --
+ * something wrote past the end of the block before it. 1 when intact. */
+int mp6_heap_check(void *heapHead, u32 heapBytes, char *why, int whyBytes)
+{
+    char *lo = (char *)heapHead, *hi = (char *)heapHead + heapBytes;
+    MEMORY_BLOCK *block = heapHead, *before = NULL;
+    do {
+        MEMORY_BLOCK *next = block->next;
+        int bad = (block->validityMarker != MEMORY_ALLOCATED_MARKER_BIT_PATTERN &&
+                   block->validityMarker != MEMORY_FREE_MARKER_BIT_PATTERN) ||
+                  block->spanBytes <= 0 || (block->spanBytes & 31) != 0 ||
+                  (char *)next < lo || (char *)next >= hi ||
+                  (next != heapHead && (char *)next != (char *)block + block->spanBytes);
+        if (!bad && next->previous != block) bad = 1;
+        if (bad) {
+            snprintf(why, (size_t)whyBytes,
+                     "block %p (offset %ld) span=%d marker=%02x alloc=%d tag=%08x caller=%08x next=%p; "
+                     "the block before: %p span=%d tag=%08x file=%08x caller=%08x",
+                     (void *)block, (long)((char *)block - lo), (int)block->spanBytes,
+                     block->validityMarker, block->isAllocated, block->allocationTag,
+                     block->callerAddress, (void *)next, (void *)before,
+                     before ? (int)before->spanBytes : 0, before ? before->allocationTag : 0,
+                     before ? before->dataFileId : 0, before ? before->callerAddress : 0);
+            return 0;
+        }
+        before = block;
+        block = next;
+    } while (block != heapHead);
+    return 1;
+}
