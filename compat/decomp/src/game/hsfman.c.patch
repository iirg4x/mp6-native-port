+static HSF_OBJECT *mp6_hsf_rebase_object(const HSF_DATA *hsf,
+                                          HSF_OBJECT *objectCopy,
+                                          const HSF_OBJECT *source)
+{
+    uintptr_t base;
+    uintptr_t address;
+    uintptr_t delta;
+    size_t bytes;
+    if(source == NULL) return NULL;
+    if(hsf == NULL || hsf->object == NULL || objectCopy == NULL
+            || hsf->objectNum <= 0
+            || (size_t)hsf->objectNum > SIZE_MAX / sizeof(HSF_OBJECT)) {
+        fprintf(stderr, "[FATAL] invalid HSF object rebase array\n");
+        _Exit(EXIT_FAILURE);
+    }
+    base = (uintptr_t)hsf->object;
+    address = (uintptr_t)source;
+    bytes = (size_t)hsf->objectNum * sizeof(HSF_OBJECT);
+    if(address < base || (delta = address - base) >= bytes
+            || delta % sizeof(HSF_OBJECT) != 0) {
+        fprintf(stderr, "[FATAL] HSF object rebase pointer outside array\n");
+        _Exit(EXIT_FAILURE);
+    }
+    return (HSF_OBJECT *)((u8 *)objectCopy + delta);
+}
