 namespace aurora::gfx {
+// Keys describe source bytes, not the converted GPU format or sampler state.
+// Object IDs select cache owners; metadata and content versions select images.
+struct TextureDataKey {
+  const void* data = nullptr;
+  u32 width = 0, height = 0, format = 0, mipCount = 0, version = 0;
+
+  static TextureDataKey from(const GXTexObj_& obj) noexcept {
+    return {obj.data, obj.width(), obj.height(), obj.format(), obj.mip_count(), obj.texDataVersion};
+  }
+  bool matches(const GXTexObj_& obj) const noexcept {
+    return data == obj.data && width == obj.width() && height == obj.height() &&
+           format == obj.format() && mipCount == obj.mip_count() && version == obj.texDataVersion;
+  }
+};
+
+struct PaletteDataKey {
+  const void* data = nullptr;
+  u32 id = 0, version = 0;
+  GXTlutFmt format = GX_TL_IA8;
+  u16 numEntries = 0;
+
+  static PaletteDataKey from(const GXTlutObj_* obj) noexcept {
+    return obj ? PaletteDataKey{obj->data, obj->tlutObjId, obj->tlutDataVersion, obj->format, obj->numEntries}
+               : PaletteDataKey{};
+  }
+  bool matches(const GXTlutObj_& obj) const noexcept {
+    return data == obj.data && id == obj.tlutObjId && version == obj.tlutDataVersion &&
+           format == obj.format && numEntries == obj.numEntries;
+  }
+};
+
 struct TextureBind {
   TextureHandle ref;
   GXTexObj_ texObj;
+  TextureDataKey sourceData;
+  PaletteDataKey paletteData;
 
   TextureBind() noexcept = default;
-  TextureBind(const GXTexObj_& obj, TextureHandle handle) noexcept : ref(std::move(handle)), texObj(obj) {}
+  TextureBind(const GXTexObj_& obj, TextureHandle handle, const GXTlutObj_* tlut = nullptr) noexcept
+  : ref(std::move(handle)), texObj(obj), sourceData(TextureDataKey::from(obj)), paletteData(PaletteDataKey::from(tlut)) {}
   void reset() noexcept { ref.reset(); }
   [[nodiscard]] wgpu::SamplerDescriptor get_descriptor() const noexcept;
   operator bool() const noexcept { return ref.operator bool(); }
