     vd[GX_VA_TEX0] = static_cast<GXAttrType>(bp_get(value, 2, 0));
     vd[GX_VA_TEX1] = static_cast<GXAttrType>(bp_get(value, 2, 2));
@@ -1230,6 +1245,7 @@
     // VAT A registers (0x70-0x77)
