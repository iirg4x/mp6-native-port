+  // Reserve a logical span for a caller that overwrites every byte before use.
+  // Unlike append_zeroes, growth does not initialize bytes that will be replaced.
+  uint8_t* append_uninitialized(size_t size) {
+    if (size == 0) return m_data ? m_data + m_length : nullptr;
+    if (size > SIZE_MAX - m_length) abort();
+    resize(m_length + size, false);
+    if (m_data == nullptr) abort();
+    uint8_t* out = m_data + m_length;
+    m_length += size;
+    return out;
+  }
