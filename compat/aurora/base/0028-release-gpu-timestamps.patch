+extern "C" void aurora_gpu_stats_read(AuroraGpuStats* out) {
+  if (!out) return;
+  using namespace aurora::webgpu::gpu_prof;
+  std::lock_guard lock(publishMutex);
+  *out={};
+  if (!supported.load()) return;
+  out->status=1;
+  if (publishedGeneration==request.load()) *out=published;
+}
