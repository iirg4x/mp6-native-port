 static constexpr float TOUCH_MOVEMENT_DECAY_RATE = 5.0f;
 static constexpr float TOUCH_CLICK_MAX_DISTANCE = DOUBLE_CLICK_MAX_DIST; // [dp]
+
+static bool update_timings_enabled() noexcept
+{
+	static const bool enabled = [] {
+		const char* value = std::getenv("MP6_RML_UPDATE_TIMINGS");
+		return value && value[0] == '1' && value[1] == '\0';
+	}();
+	return enabled;
+}
+
+struct UpdateTimings
+{
+	using Clock = std::chrono::steady_clock;
+	static constexpr unsigned REPORT_PERIOD = 600;
+
+	const bool enabled = update_timings_enabled();
+	std::array<Clock::time_point, 7> marks{};
+
+	void Mark(size_t index)
+	{
+		if (enabled)
+			marks[index] = Clock::now();
+	}
+
+	void Report()
+	{
+		if (!enabled)
+			return;
+
+		static std::array<double, 6> totals{};
+		static unsigned frames = 0;
+		const auto milliseconds = [&](size_t from, size_t to) {
+			return std::chrono::duration<double, std::milli>(marks[to] - marks[from]).count();
+		};
+		const std::array sample{milliseconds(0, 1), milliseconds(1, 2), milliseconds(2, 3), milliseconds(3, 4), milliseconds(4, 5),
+			milliseconds(5, 6)};
+		for (size_t i = 0; i < totals.size(); ++i)
+			totals[i] += sample[i];
+
+		if (++frames == REPORT_PERIOD)
+		{
+			Log::Message(Log::LT_INFO,
+				"[MP6-RML-UPDATE-TIMINGS] frames=%u prelude_ms=%.6f hover_ms=%.6f data_ms=%.6f root_update_ms=%.6f layout_ms=%.6f "
+				"release_ms=%.6f",
+				frames, totals[0] / frames, totals[1] / frames, totals[2] / frames, totals[3] / frames, totals[4] / frames, totals[5] / frames);
+			totals = {};
+			frames = 0;
+		}
+	}
+};
 
