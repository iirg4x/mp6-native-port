/* Adapted from mariopartyrd/partyboard (unlicensed upstream; see docs/PARTYBOARD_PROVENANCE.md).
 * Credit: TwilitRealm. */
tab-bar {
    display: flex;
    position: relative;
    min-width: 0;
    overflow: auto hidden;
    clip: always;
    text-transform: none;
}

tab-bar scrollbarhorizontal,
tab-bar scrollbarhorizontal sliderarrowdec,
tab-bar scrollbarhorizontal sliderarrowinc,
tab-bar scrollbarhorizontal slidertrack,
tab-bar scrollbarhorizontal sliderbar {
    width: 0;
    height: 0;
}

tab-bar tab {
    flex: 0 0 auto;
    padding: 0 24dp;
    line-height: 64dp;
    white-space: nowrap;
    background-color: transparent;
    transition: background-color color 0.12s linear-in-out;
    cursor: pointer;
}

tab-bar tab:selected {
    opacity: 1;
    border-bottom: 4dp #ffcd3a;
    background-color: #e92313;
    color: #ffffff;
}

tab-bar tab:focus-visible,
tab-bar tab:hover {
    opacity: 1;
    background-color: #e92313;
    color: #ffffff;
}

tab-bar tab:active {
    background-color: #bd190c;
}

tab-bar[closable] tab-end-spacer {
    display: block;
    flex: 0 0 64dp;
    width: 64dp;
    pointer-events: none;
}

tab-bar[closable] close {
    display: block;
    position: fixed;
    top: 8dp;
    right: 8dp;
    z-index: 1;
    width: 48dp;
    height: 48dp;
    font-family: "Material Symbols Rounded";
    font-weight: normal;
    font-size: 20dp;
    color: #17100b;
    background-color: #f3e7bd;
    border-radius: 6dp;
    decorator: text("&#xe5cd;" center center);
    transition: color background-color 0.12s linear-in-out;
    cursor: pointer;
}

tab-bar[closable] close:hover,
tab-bar[closable] close:focus-visible {
    color: #fff;
    background-color: #e92313;
}

tab-bar[closable] close:active {
    color: #fff;
    background-color: #bd190c;
}
