/* Adapted from mariopartyrd/partyboard (unlicensed upstream; see docs/PARTYBOARD_PROVENANCE.md).
 * Credit: TwilitRealm. */
*, *:before, *:after {
    box-sizing: border-box;
}

body {
    overflow: visible;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    font-family: "Titan One";
    font-weight: normal;
    font-size: 20dp;
    color: #17100b;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: stretch;
}

.tuner-root {
    width: 100%;
    min-height: 45%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: stretch;
    background-color: #fff9e7;
    border-top: 3dp #dfbd60;
    filter: opacity(0);
    transition: filter 0.2s linear-in-out;
}

.tuner-root[open] {
    filter: opacity(1);
}

.tuner {
    width: 100%;
    max-width: 1216dp;
    margin-left: auto;
    margin-right: auto;
    display: flex;
    flex-direction: column;
    gap: 24dp;
    padding: 48dp 64dp;
}

@media (max-height: 800dp) {
    .tuner-root {
        min-height: 38%;
    }

    .tuner {
        gap: 16dp;
        padding: 32dp 48dp;
    }
}

.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24dp;
}

.carousel-container {
    flex: 1 1 auto;
    display: flex;
    justify-content: flex-end;
    min-width: 0;
}

.description {
    font-size: 14dp;
    line-height: 22dp;
    color: #0900ed;
}

.divider {
    margin: 1dp 0;
    border-top: 1dp #dfbd60;
}

.footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24dp;
}

footer-button {
    display: block;
    width: 100%;
    max-width: 220dp;
    border: 0;
    padding: 8dp 12dp;
    border-radius: 8dp;
    background-color: #f3e7bd;
    font-family: "Titan One";
    font-weight: normal;
    font-size: 16dp;
    line-height: 24dp;
    text-transform: none;
    color: #17100b;
    opacity: 1;
    cursor: pointer;
}

footer-button.return {
    text-align: left;
}

footer-button.reset {
    text-align: right;
}

.stepped-carousel {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16dp;
    width: auto;
    min-width: 246dp;
    padding: 0;
    background-color: transparent;
    font-family: "Titan One";
    font-weight: normal;
}

.stepped-carousel-value {
    line-height: 29dp;
    min-width: 166dp;
    text-align: center;
    white-space: nowrap;
    opacity: 0.9;
}

.stepped-carousel-arrow {
    width: 24dp;
    height: 24dp;
    min-width: 24dp;
    padding: 0;
    border: 0;
    background-color: transparent;
    opacity: 1;
    cursor: pointer;
    font-family: "Material Symbols Rounded";
    font-weight: normal;
    color: #d49a00;
}

footer-button:hover, footer-button:focus-visible {
    background-color: #e92313;
    color: #ffffff;
}
.stepped-carousel-arrow:hover, .stepped-carousel-arrow:focus-visible { color: #df200c; }
.stepped-carousel-arrow:disabled { color: #817b70; cursor: default; }
