/* Opening spread of MP6's day/night storybook. The native mesh shares Settings'
   proportional art, paper warp, Titan One ink and animated ribbon/star cursor.
   Semantic controls remain focusable, but never paint a second copy. */
* { box-sizing: border-box; }
body { width: 100%; height: 100%; margin: 0; font-family: "Titan One"; color: #000000; }
content { display: block; position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
content:not([open]) { display: none; }
storybook-view { display: block; position: absolute; left: 0; top: 0; width: 100%; height: 100%; focus: auto; z-index: 1; cursor: pointer; }
#menu-list { position: absolute; left: 9%; top: 30%; width: 40%; height: 38%; z-index: 2; pointer-events: none; opacity: 0; }
#menu-list button { display: block; width: 100%; height: 30%; font-family: "Titan One"; font-size: 32dp; }
#menu-list, #menu-list * { opacity: 0; pointer-events: none; }
