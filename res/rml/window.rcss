/* Adapted from mariopartyrd/partyboard (unlicensed upstream; see docs/PARTYBOARD_PROVENANCE.md).
 * Credit: TwilitRealm. */
*, *:before, *:after {
    box-sizing: border-box;
}

body {
    display: flex;
    width: 100%;
    height: 100%;
    padding: 64dp;
    font-family: "Titan One";
    font-weight: normal;
    font-style: normal;
    font-size: 12dp;
    color: #17100b;
}

window {
    display: flex;
    flex-flow: column;
    position: relative;
    height: 100%;
    width: 100%;
    max-width: 1088dp;
    max-height: 768dp;
    margin: auto;
    border-radius: 12dp;
    overflow: hidden;
    border: 2dp #dfbd60;
    box-shadow: 0 4dp 0 1dp #a87a28;
    /* Opaque paper: game highlights cannot bleed through dialog text. */
    background-color: #fff9e7;
    filter: opacity(0);
    transform: scale(0.9);
    transform-origin: center;
    transition: filter transform 0.2s cubic-in-out;
}

window.small {
    height: auto;
    width: auto;
}

window.modal {
    max-width: 640dp;
}

window[open] {
    filter: opacity(1);
    transform: scale(1);
}

@media (max-height: 640dp) {
    body {
        padding: 16dp;
    }
    window {
        box-shadow: none;
    }
}

window tab-bar {
    flex: 0 0 64dp;
    height: 64dp;
    background-color: #f3e7bd;
    font-family: "Titan One";
    font-weight: normal;
    font-size: 18dp;
    border-bottom: 2dp #dfbd60;
}

window tab-bar tab {
    opacity: 1;
}

window content {
    display: flex;
    flex: 1 1 auto;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
}

window content pane {
    display: flex;
    flex-flow: column;
    flex: 1 1 0;
    min-width: 0;
    min-height: 0;
    padding: 24dp;
    padding-bottom: 0dp;
    gap: 8dp;
    overflow: hidden auto;
    font-size: 16dp;
}

window content pane:not(:last-of-type) {
    border-right: 1dp #dfbd60;
}

window content pane > * {
    flex: 0 0 auto;
}

window content pane:last-of-type > div {
    line-height: 1.625;
}

window content pane > spacer {
    display: block;
    /* Completes the 24dp bottom inset after the pane's 8dp gap. */
    flex: 0 0 16dp;
    height: 16dp;
    pointer-events: none;
}

scrollbarvertical {
    width: 8dp;
    margin: 4dp 4dp 4dp 0;
}

scrollbarvertical sliderarrowdec,
scrollbarvertical sliderarrowinc {
    width: 0;
    height: 0;
}

scrollbarvertical slidertrack {
    width: 8dp;
}

scrollbarvertical sliderbar {
    width: 8dp;
    min-height: 24dp;
    background-color: #dfbd60;
    border-radius: 2dp;
    transition: background-color 0.2s cubic-in-out;
}

scrollbarvertical sliderbar:hover,
scrollbarvertical sliderbar:active {
    background-color: #a87a28;
}

scrollbarhorizontal {
    height: 0;
}

scrollbarhorizontal sliderarrowdec,
scrollbarhorizontal sliderarrowinc {
    width: 0;
    height: 0;
}

scrollbarhorizontal slidertrack,
scrollbarhorizontal sliderbar {
    width: 0;
    height: 0;
}

.section-heading {
    font-family: "Titan One";
    font-weight: normal;
    text-transform: none;
    font-size: 18dp;
    color: #df200c;
}

.section-heading:not(:first-of-type) {
    padding-top: 12dp;
}

button {
    text-align: center;
    background-color: #f3e7bd;
    color: #17100b;
    opacity: 1;
    padding: 8dp 16dp;
    border-radius: 8dp;
    border: 1dp #dfbd60;
    font-size: 16dp;
    transition: background-color color 0.12s linear-in-out;
    cursor: pointer;
    focus: auto;
}

button:not(:disabled):hover,
button:not(:disabled):focus-visible {
    background-color: #e92313;
    color: #ffffff;
    box-shadow: #e6b624 0 0 0 2dp;
}

button:not(:disabled):selected {
    opacity: 1;
    background-color: #e92313;
    color: #ffffff;
}

button:not(:disabled):active {
    opacity: 1;
    background-color: #bd190c;
    color: #ffffff;
    box-shadow: #e6b624 0 0 0 2dp;
}

button:disabled { color: #817b70; background-color: #e9e3d2; cursor: default; }

button.modal-btn {
    flex: 1 1 0;
    text-align: center;
}

/* Auxiliary lists share the book lettering; settings remain inline arrows. */
window content pane > button {
    text-align: left;
    font-family: "Titan One";
    font-weight: normal;
    text-transform: none;
    font-size: 18dp;
}

select-button {
    display: flex;
    align-items: center;
    gap: 8dp;
    background-color: #f3e7bd;
    color: #17100b;
    opacity: 1;
    padding: 8dp 16dp;
    border-radius: 8dp;
    border: 1dp #dfbd60;
    transition: background-color color 0.12s linear-in-out;
    cursor: pointer;
    focus: auto;
}

select-button:not(:disabled):hover,
select-button:not(:disabled):focus-visible {
    background-color: #e92313;
    color: #ffffff;
    box-shadow: #e6b624 0 0 0 2dp;
}

select-button:not(:disabled):selected {
    opacity: 1;
    background-color: #e92313;
    color: #ffffff;
}

select-button:not(:disabled):active {
    opacity: 1;
    background-color: #bd190c;
    color: #ffffff;
    box-shadow: #e6b624 0 0 0 2dp;
}

select-button:disabled {
    color: #817b70;
    background-color: #e9e3d2;
    cursor: default;
}

select-button key {
    font-family: "Titan One";
    font-weight: normal;
    font-size: 16dp;
    text-transform: none;
    flex: 0 1 auto;
}

select-button value {
    flex: 1 1 auto;
    text-align: right;
    font-size: 16dp;
}

select-button value.modified {
    color: #0900ed;
}

select-button input {
    text-align: right;
    font-size: 16dp;
}

icon {
    width: 1em;
    height: 1em;
    font-family: "Material Symbols Rounded";
    font-weight: normal;
    display: inline-block;
    vertical-align: middle;
}

icon.warning {
    decorator: text("&#xe002;" center center);
}

icon.error {
    decorator: text("&#xe000;" center center);
}

icon.verifying {
    decorator: text("&#xe8b5;" center center);
}

icon.celebration {
    decorator: text("&#xea65;" center center);
}

icon.question-mark {
    decorator: text("&#xeb8b;" center center);
}

.achievement-total {
    position: absolute;
    top: 0;
    right: 64dp;
    height: 64dp;
    line-height: 64dp;
    font-family: "Inter";
    font-weight: bold;
    font-size: 13dp;
    color: #756345;
    pointer-events: none;
}

.achievement-row {
    display: flex;
    align-items: flex-start;
    gap: 10dp;
    padding: 12dp 0;
    border-bottom: 1dp rgba(146, 135, 91, 30%);
}

.achievement-info {
    display: block;
    flex: 1 1 0;
    min-width: 0;
}

.achievement-header {
    display: flex;
    align-items: center;
}

.achievement-name {
    flex: 1;
    font-weight: bold;
}

.achievement-name.unlocked {
    color: #765616;
}

.achievement-badge {
    font-size: 14dp;
    opacity: 0.7;
}

.achievement-badge.unlocked {
    color: #287138;
    opacity: 1;
}

.achievement-badge.locked {
    color: #cc4444;
    opacity: 1;
}

.achievement-desc {
    display: block;
    color: #0900ed;
    font-size: 16dp;
    margin: 4dp 0 0 0;
}

.achievement-progress {
    display: block;
    font-size: 13dp;
    color: #756345;
}

progress {
    display: block;
    width: 100%;
    height: 6dp;
    border-radius: 3dp;
    background-color: #e9dfbe;
    margin: 6dp 0 2dp 0;
}

progress.progress-done fill {
    background-color: #287138;
    border-radius: 3dp;
}

progress.progress-ongoing fill {
    background-color: #e6b624;
    border-radius: 3dp;
}

button.achievement-clear {
    flex: 0 0 auto;
    align-self: center;
    font-size: 14dp;
    padding: 2dp 8dp;
    opacity: 0.45;
}

.preset-grid {
    display: flex;
    flex-direction: row;
    gap: 20dp;
    flex: 0 1 auto;
    align-items: flex-start;
    width: 100%;
}

.preset-col {
    display: flex;
    flex-flow: column;
    gap: 12dp;
    flex: 1 1 0;
}

.preset-desc {
    display: block;
    font-size: 16dp;
    text-align: center;
}

/* [MP6] ADDITIVE BLOCK -- the Enhancements preset comparison table (settings
 * window, right pane beside the Preset row). Not partyboard's.
 *
 * ASPECT-ADAPTIVE, the same way every other launcher surface in this port is
 * (docs/A5_LAUNCHER_ASPECT.md): the columns are flex-sized rather than fixed,
 * and the @media breakpoint below is partyboard's OWN mobile breakpoint --
 * the identical (max-height: 640dp) rule the window padding, the prelaunch
 * hero and the overlay already switch on -- so a phone in landscape gets the
 * tighter table through the same mechanism, not a second one invented here.
 * On the narrowest surfaces the value columns shrink and the label column
 * absorbs the loss; the pane it lives in already scrolls. */
.enh-matrix {
    display: flex;
    flex-flow: column;
    gap: 4dp;
    width: 100%;
    font-size: 15dp;
}

.enh-matrix-row {
    display: flex;
    flex-flow: row;
    gap: 8dp;
    width: 100%;
}

.enh-matrix-label {
    display: block;
    flex: 1 1 0;
    min-width: 0;
    color: #756345;
}

.enh-matrix-val {
    display: block;
    flex: 0 1 76dp;
    min-width: 0;
    text-align: right;
}

.enh-matrix-head {
    font-family: "Inter";
    font-weight: bold;
    text-transform: uppercase;
    font-size: 12dp;
    color: #df200c;
    border-bottom: 1dp rgba(146, 135, 91, 30%);
    padding-bottom: 4dp;
}

@media (max-height: 640dp) {
    .enh-matrix {
        font-size: 13dp;
        gap: 2dp;
    }
    .enh-matrix-row {
        gap: 4dp;
    }
    .enh-matrix-val {
        flex: 0 1 56dp;
    }
    .enh-matrix-head {
        font-size: 11dp;
    }
}

.modal-dialog {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 24dp;
    gap: 20dp;
    flex: 0 1 auto;
    width: 100%;
    text-align: left;
    overflow-y: auto;
}

window.modal.danger {
    border-color: #df200c;
}

.modal-header {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    flex: 0 0 auto;
    gap: 16dp;
}

.modal-header icon {
    font-size: 24dp;
    color: #df200c;
}

.modal-title {
    display: block;
    font-family: "Titan One";
    font-weight: normal;
    text-transform: none;
    font-size: 24dp;
    color: #df200c;
    flex: 1 1 auto;
}

window.modal.danger .modal-title,
window.modal.danger .modal-header icon {
    color: #B3261E;
}

.modal-body {
    display: block;
    width: 100%;
    flex: 0 1 auto;
    min-width: 0;
    font-size: 16dp;
    color: #17100b;
    font-weight: normal;
    line-height: 1.4;
}

.modal-body span.tip {
    font-size: 14dp;
    color: #0900ed;
}

.verification-progress {
    display: flex;
    flex-direction: column;
    gap: 10dp;
    width: 100%;
}

.verification-file {
    display: block;
    font-size: 17dp;
    color: #17100b;
}

progress.verification-progress-bar {
    height: 8dp;
    margin: 2dp 0 0 0;
}

.verification-detail {
    display: block;
    font-size: 14dp;
    color: #756345;
}

.modal-actions {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: stretch;
    gap: 12dp;
    width: 100%;
    flex: 0 0 auto;
    padding-top: 4dp;
}

/* First-launch linking uses the same paper, with roomier onboarding copy. */
body.content-link-document { padding: 0; background-color: rgba(11, 6, 45, 48%); }
window.content-link { width: 90vw; max-width: 720dp; max-height: 90vh; border: 3dp #e0b544;
    border-radius: 20dp; background-color: #fff9e7; backdrop-filter: none;
    box-shadow: none; font-family: "Titan One"; transition: transform 0.2s cubic-out; }
window.content-link[open] { filter: none; }
.content-link .modal-dialog { padding: 32dp; gap: 24dp; overflow-y: auto; }
.content-link .modal-title { font-family: "Titan One"; font-weight: normal;
    font-size: 32dp; text-transform: none; color: #df200c; }
.content-link .modal-body { font-family: "Titan One"; font-size: 18dp; line-height: 1.5; color: #0900ed; }
.content-link .modal-actions { flex-direction: column; gap: 10dp; }
.content-link button.modal-btn { width: 100%; min-height: 48dp; padding: 10dp 20dp;
    border: 1dp #ddbb59; border-radius: 12dp; background-color: #f3e7bd;
    decorator: none; box-shadow: none; color: #000000; font-family: "Titan One"; font-size: 20dp;
    font-weight: normal; text-transform: none; text-align: center; }
.content-link button.modal-btn:focus-visible, .content-link button.modal-btn:hover,
    .content-link button.modal-btn:active { background-color: #ec250f; color: #ffffff; decorator: none; box-shadow: none; border-color: #ddbb59; }
.content-link .verification-file { color: #000000; font-family: "Titan One"; font-size: 18dp; }
.content-link .verification-detail { color: #0900ed; font-family: "Titan One"; font-size: 16dp; }
@media (max-height: 640dp) {
    .content-link .modal-dialog { padding: 20dp; gap: 14dp; }
    .content-link .modal-title { font-size: 26dp; }
    .content-link .modal-body { font-size: 16dp; line-height: 1.35; }
    .content-link button.modal-btn { min-height: 44dp; font-size: 18dp; padding: 8dp 16dp; }
}
@media (max-width: 560dp) {
    .content-link .modal-dialog { padding: 20dp; gap: 14dp; }
    .content-link .modal-title { font-size: 26dp; }
    .content-link .modal-body { font-size: 16dp; line-height: 1.35; }
    .content-link button.modal-btn { min-height: 44dp; font-size: 18dp; padding: 8dp 16dp; }
}
