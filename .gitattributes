# Deterministic line endings: compatibility patches and headers are byte-hashed
# into renderer artifact fingerprints. Windows launchers use CRLF below.
*                       text=auto eol=lf

# ---------------------------------------------------------------------------
# Text, forced -- no content sniffing. These are the files whose exact bytes
# the build, the gates, and the patch appliers depend on.
# ---------------------------------------------------------------------------

# Patch series: compat/aurora/base/ (byte-hashed into the Aurora
# provenance fingerprint) and compat/decomp*/ (applied to the read-only
# decomp checkout).
*.patch                 text eol=lf

# Engine and shim sources.
*.c                     text eol=lf
*.h                     text eol=lf
*.cpp                   text eol=lf
*.hpp                   text eol=lf
*.inc                   text eol=lf

# Tooling, setup, harnesses.
*.py                    text eol=lf
*.sh                    text eol=lf

# Android lane.
*.java                  text eol=lf
*.gradle                text eol=lf
*.properties            text eol=lf
*.xml                   text eol=lf
gradlew                 text eol=lf

# UI resources (RmlUi documents/stylesheets) and shaders.
*.rml                   text eol=lf
*.rcss                  text eol=lf
*.wgsl                  text eol=lf

# Documentation, data, build config, version stamps.
*.md                    text eol=lf
*.txt                   text eol=lf
*.json                  text eol=lf
*.yml                   text eol=lf
*.yaml                  text eol=lf
*.toml                  text eol=lf
*.js                    text eol=lf
*.cmake                 text eol=lf
VERSION                 text eol=lf
VERSION_CODE            text eol=lf
.gitignore              text eol=lf
.gitattributes          text eol=lf

# ---------------------------------------------------------------------------
# Binary -- never converted, never diffed as text.
#
# The first group is every binary extension currently tracked, swept from
# `git ls-files --eol` (the "i/-text" rows): .png .jpg .dll .ttf .otf .jar
# .gci. The second group is declared ahead of time so a build artifact or
# capture that lands in the tree later cannot be silently line-ending
# mangled by whoever adds it.
# ---------------------------------------------------------------------------
*.png                   binary
*.jpg                   binary
*.dll                   binary
*.ttf                   binary
*.otf                   binary
*.jar                   binary
*.gci                   binary

*.jpeg                  binary
*.gif                   binary
*.bmp                   binary
*.tga                   binary
*.ico                   binary
*.webp                  binary
*.apk                   binary
*.aab                   binary
*.so                    binary
*.exe                   binary
*.pdb                   binary
*.lib                   binary
*.a                     binary
*.o                     binary
*.obj                   binary
*.bin                   binary
*.mfd                   binary
*.dat                   binary
*.raw                   binary
*.hsf                   binary
*.rel                   binary
*.dol                   binary
*.tpl                   binary
*.iso                   binary
*.gcm                   binary
*.zip                   binary
*.gz                    binary
*.7z                    binary
*.wav                   binary
*.ogg                   binary
*.mp4                   binary
*.pdf                   binary

# ---------------------------------------------------------------------------
# CRLF, deliberately -- Windows-only launchers.
#
# cmd.exe's batch parser is the one consumer here that genuinely misbehaves
# on LF-only input (mid-file labels/goto), and Gradle ships gradlew.bat CRLF
# upstream. setup/run.ps1 / tools/winshot.ps1 are kept CRLF alongside them for
# consistency; nothing hashes either, so this costs nothing. Note the
# companion POSIX launchers (setup.sh, gradlew) are LF above -- that pairing
# is the point.
# ---------------------------------------------------------------------------
*.bat                   text eol=crlf
*.ps1                   text eol=crlf
