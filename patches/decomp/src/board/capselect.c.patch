--- a/src/board/capselect.c
+++ b/src/board/capselect.c
@@ -925,0 +926,46 @@
+    /* PORT SEAM GUARD -- mbCapMasuNextGet (both branches above) is a logged
+     * placeholder in platform/os/board_placeholders.c that returns -1, "no
+     * capsule": the pinned decomp declares it (this file's own extern, pin
+     * line 36) but has not recovered it, and the no-disassembly rule keeps
+     * it a seam rather than an invention.
+     *
+     * Everything below treats capsuleNo as a REAL capsule number, and every
+     * read of it funnels through mbCapValueTypeGet(), which is
+     * `return value & 0xFF;` (capsule.c pin line 1830) -- so -1 becomes 255
+     * and indexes capsuleData[], a 60-entry file static (capsule.c pin lines
+     * 325-386), out of bounds inside mbCapUseMesGet (capsule.c pin line
+     * 2443).  That table is a REAL ARRAY, not a heap pointer, so zig cc's
+     * default -fsanitize=array-bounds traps the access outright instead of
+     * quietly reading a neighbour, and BOTH branches below reach it (pin
+     * lines 942 and 1001).  This is also the guard that keeps the
+     * mbCapObjCreate panic further down this file from being reachable at
+     * all: mbCapCapsuleGet has exactly one caller, pin line 934 below.
+     *
+     * Skipping the award is the seam's own no-content answer: the player
+     * lands on the capsule space and receives nothing.  mbCapMasuExec
+     * returns void, and its only caller mbev_MasuMove (masu.c pin line 760,
+     * the call at pin line 775) continues into
+     * mbev_CapCall(playerNo, mbMasuCapsuleGet(id), FALSE, TRUE) at masu.c
+     * pin line 786 either way -- that argument is read from the SPACE's own
+     * board data, never from the capsule this function would have awarded,
+     * so leaving early does not starve the caller's own follow-up.
+     *
+     * The test is this file's OWN idiom, not a new convention: the tutorial
+     * branch four lines up already reads capsuleNo < 0 as "no capsule".  And
+     * every paired call this skips is skipped in PAIRS --
+     * mbMoveNumDispSet(playerNo, FALSE) at pin line 928 pairs with its TRUE
+     * partner at pin line 1011, and the tutorial close at pin lines
+     * 1008-1010 is re-issued here because the original makes that close
+     * conditional on the FLAG, not on whether the 0x15 open succeeded.  (On the pinned
+     * tree neither tutorial side runs: nothing sets FLAG_BOARD_TUTORIAL, and
+     * mbTutorialCall returns -1 immediately when it is clear, tutorial.c pin
+     * lines 277-279.  The pairing is here so a later recovery that does set
+     * the flag cannot inherit an unbalanced open.)
+     *
+     * Delete when the seam lands on decomp main. */
+    if (capsuleNo < 0) {
+        if (_CheckFlag(FLAG_BOARD_TUTORIAL)) {
+            mbTutorialCall(0x16);
+        }
+        return;
+    }
@@ -1100,0 +1147,47 @@
+    /* PORT SEAM GUARD -- mbCapObjCreate (the line above) is a logged
+     * placeholder in platform/os/board_placeholders.c that returns
+     * MB_MODEL_NONE (-1), "no object": the pinned decomp declares it (this
+     * file's own extern, pin line 26) but has not recovered it.
+     *
+     * The whole rest of this function is the capsule's pickup animation on
+     * that ONE object, and not one step of it checks.  mbObjAttrSet /
+     * mbObjCameraSet / mbObjLayerSet / mbObjPosSetV / mbObjScaleSet each
+     * index objManData[modelId] with no bounds test of their own (object.c
+     * pin line 533 is the shape they all share).  That one is NOT trapped:
+     * objManData is a heap pointer, not an array (object.c pin lines 20 and
+     * 54), so index -1 silently reads and writes the bytes in front of the
+     * allocation and the run keeps going.
+     *
+     * What actually stopped the run is the closing mbCapObjKill(-1) at pin
+     * line 1132.  MB_MODEL_NONE is ALSO the idle value of every
+     * capsuleObjData[] slot -- all eight are initialised to it at capsule.c
+     * pin line 2592 -- so the linear search at capsule.c pin lines 2924-2928
+     * MATCHES slot 0, takes the "found a live capsule object" branch, and
+     * dereferences that slot's NULL .anim inside HuSprAnimKill (sprman.c pin
+     * line 412, `if(--anim->useNum <= 0)`).  A null member access IS trapped,
+     * and it panicked on 3 runs out of 3 of the retail board path: "member
+     * access within null pointer of type 'ANIMDATA'", the stack being
+     * mbCapObjKill (capsule.c pin line 2920) <- mbCapCapsuleGet (pin line
+     * 1132) <- mbCapMasuExec (pin line 934) <- mbev_MasuMove (masu.c pin
+     * line 775).
+     *
+     * No return value can close this from the placeholder side: every int a
+     * handle seam can produce is either that sentinel or a live
+     * objManData[] index, and there is no third answer -- so the CALLER is
+     * what has to be guarded, the same shape as mbTelopTimeSprCreate's guard
+     * in pause.c.patch.  With no object there is nothing to animate, so this
+     * leaves at once; the two mbAudFXPlay beats below belong to the capsule
+     * that was never created, and nothing above this point has been started
+     * that needs closing.  The test is this file's own idiom again -- its
+     * three other mbCapObjKill sites already check the id first (pin lines
+     * 197, 289 and 795).
+     *
+     * The mbCapMasuNextGet guard above currently keeps this one unreachable
+     * (that seam declines every capsule, so pin line 934 never runs).  They
+     * are still both needed and they are not redundant: recovering either
+     * seam alone re-opens the other's hazard, and this is the half that
+     * closes the panic the moment mbCapMasuNextGet starts naming real
+     * capsules.  Delete when the seam lands on decomp main. */
+    if (objId < 0) {
+        return;
+    }
