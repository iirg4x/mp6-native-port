--- a/src/board/pause.c
+++ b/src/board/pause.c
@@ -13,0 +14 @@
+#include "mp6_widescreen.h" /* widescreen support */
@@ -251,4 +252,24 @@
-        mbTelopTimeSprRotSet(work->telopId, 0.0f);
-        mbTelopTimeDispSet(work->telopId, FALSE);
-        HuSprGrpPosSet(work->telopId, 288.0f * 0.35f, 216.0f);
-        HuSprGrpScaleSet(work->telopId, 0.65f, 0.65f);
+        /* PORT SEAM GUARD -- mbTelopTimeSprCreate (the line above) is a
+         * logged placeholder in platform/os/board_placeholders.c that
+         * returns -1, "no sprite": the pinned decomp declares it (pause.c's
+         * own extern, line 54) but has not recovered it, and the
+         * no-disassembly rule keeps it a seam rather than an invention.
+         * Every call in this block then indexes HuSprGrpData[grpId] with no
+         * bounds check of its own -- sprman.c:427 in HuSprAttrSet, reached
+         * through mbTelopTimeDispSet -> HuSprDispOff (telop.c:122), and
+         * sprman.c:566 / :604 in HuSprGrpPosSet / HuSprGrpScaleSet, the
+         * latter two of which WRITE through that pointer, so -1 is an
+         * out-of-bounds STORE and not merely a read.  Opening the board
+         * pause menu panicked on the first of them: "index -1 out of bounds
+         * for type 'HUSPR_GROUP[256]'".
+         *
+         * The guard is this file's OWN idiom rather than a new convention:
+         * the pinned source already reads telopId < 0 as "no telop sprite
+         * exists" at all four of its other use sites (the kill at pin line
+         * 287, the show/hide pair at 412 and 460, the spin at 512).  Only
+         * the creation block was written assuming mbTelopTimeSprCreate
+         * cannot fail -- true on retail, which is why this is inert on a
+         * hardware build.  Delete when that seam lands on decomp main. */
+        if(work->telopId >= 0) {
+            mbTelopTimeSprRotSet(work->telopId, 0.0f);
+            mbTelopTimeDispSet(work->telopId, FALSE);
+            HuSprGrpPosSet(work->telopId, 288.0f * 0.35f, 216.0f);
+            HuSprGrpScaleSet(work->telopId, 0.65f, 0.65f);
+        }
@@ -750,2 +751,21 @@
-        mbWinSizeSet(work->mgWin[i], 268, winSize.y);
-        mbWinPosSet(work->mgWin[i], winPos.x + ((i & 1) ? 268 : 0), winPos.y);
+        /* These two side-by-side minigame-description windows' WIDTH (the
+         * 268 below) and the horizontal OFFSET placing the SECOND window
+         * flush against the first (the OTHER 268, in mbWinPosSet) are the
+         * same conceptual quantity used twice in two different function
+         * calls that must move in lockstep, which is why this is an
+         * individual, targeted fix (both derived from the SAME literal via
+         * the SAME factor, right here) rather than something the generic
+         * position-shift shim (sprman.c's HuSprGrpPosSet) could keep
+         * synchronized on its own -- mbWinSizeSet itself is deliberately
+         * NOT globally wrapped (a window's on-screen centering is often
+         * computed by its OWN caller from its own local, unscaled size
+         * variable elsewhere in this codebase; scaling sizes globally
+         * would desync those call sites' own half-width math from the
+         * actual rendered size). No-op when disabled. */
+        mbWinSizeSet(work->mgWin[i], 268 * mp6_widescreen_scale_factor(), winSize.y);
+        mbWinPosSet(work->mgWin[i],
+            winPos.x + ((i & 1) ? (268 * mp6_widescreen_scale_factor()) : 0), winPos.y);
