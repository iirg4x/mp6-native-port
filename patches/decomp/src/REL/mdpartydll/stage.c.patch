--- a/src/REL/mdpartydll/stage.c
+++ b/src/REL/mdpartydll/stage.c
@@ -14,0 +15 @@
+#include "mp6_widescreen.h" /* widescreen support */
@@ -116 +117 @@
-        GXSetTexCopySrc(0, 0, 640, 480);
+        GXSetTexCopySrc(0, 0, mp6_widescreen_render_width(), 480);
@@ -147,0 +149,22 @@
+    /* This is the OTHER half of the board-confirm transition: fn_1_3F580
+     * (widened just above) photographs the frame, and this material hook
+     * re-projects that photograph back onto the warp plane the confirm
+     * throws across the screen -- the shockwave that swaps the rotating
+     * board-select background for the chosen board's preview.
+     *
+     * C_MTXLightPerspective(m, fovY, ASPECT, scaleS, scaleT, transS,
+     * transT) builds that reprojection, and it only lands on the right
+     * texels if its aspect is the aspect the photograph was actually
+     * rendered at. The author took fov from the live camera but wrote the
+     * aspect as the native literal 1.2f -- fine while every camera in the
+     * game was 4:3, wrong the moment mp6_widescreen_camera_widen() starts
+     * handing cameras 1.2f * scale_factor(). Left native, the reprojection
+     * assumes a narrower frame than the one on screen: the warped copy
+     * comes out horizontally stretched by scale_factor(), and whatever
+     * falls outside u=[0,1] smears as GX_CLAMP edge texels down the left
+     * and right sides. Widening the SOURCE capture alone (the hunk above)
+     * could not fix that -- it made the photograph correct while this
+     * mapping still read it as if it were 4:3.
+     *
+     * scale_factor() is exactly 1.0f when widescreen is disabled, so this
+     * is the byte-identical 1.2f in that case. */
@@ -149 +172,2 @@
-        lightMtx, camera->fov, 1.2f, 0.5f, -0.5f, 0.5f, 0.5f);
+        lightMtx, camera->fov, 1.2f * mp6_widescreen_scale_factor(),
+        0.5f, -0.5f, 0.5f, 0.5f);
@@ -323 +347,23 @@
-    MTXOrtho(projection, 0.0f, 480.0f, 0.0f, 640.0f, 0.0f, 10.0f);
+    /* fn_1_400E0 is a full-screen fade/dissolve overlay (a low-res,
+     * previous-frame screenshot cross-faded in over ~90 frames, the
+     * "heat-haze"-looking transition this file's own board-preview stage
+     * uses between its setup screens) with its own independent,
+     * hardcoded-native ortho + quad + capture, completely bypassing the
+     * shared, already-widened HuSprDispInit ortho (game/sprput.c) and this
+     * REL's own Party board camera. Left native, this overlay only ever
+     * covered the original 640-wide strip of a now-wider frame -- widened
+     * here to actually fill it, same WIDEN (not recenter -- this is a
+     * full-bleed background effect, not logically-centered content)
+     * treatment already proven for game/wipe.c's own near-identical
+     * inflated-corner full-screen quad. mp6_widescreen_render_width() is
+     * exactly 640 when widescreen is disabled, so every touched line below
+     * is byte-identical to the original in that case. GXSetTexCopyDst's
+     * own 320x240 destination is deliberately left alone -- lbl_1_bss_A90's
+     * backing allocation is a fixed-size buffer; changing only the SOURCE
+     * capture width (below) changes the hardware downscale ratio, not the
+     * destination's own byte size, so there is no overflow risk -- and
+     * since the quad this texture paints onto is ALSO widened to the same
+     * render_width, the extra horizontal squish from capturing a wider
+     * source into the same fixed-width destination is exactly undone when
+     * that texture is stretched back across the (equally wider) quad. */
+    MTXOrtho(projection, 0.0f, 480.0f, 0.0f, mp6_widescreen_render_width(), 0.0f, 10.0f);
@@ -381 +427 @@
-        GXPosition3f32(640 + i, i * -1, 0.0f);
+        GXPosition3f32(mp6_widescreen_render_width() + i, i * -1, 0.0f);
@@ -387 +433 @@
-        GXPosition3f32(640 + i, 480 + i, 0.0f);
+        GXPosition3f32(mp6_widescreen_render_width() + i, 480 + i, 0.0f);
@@ -399,2 +445,10 @@
-
-    GXSetTexCopySrc(0, 0, 640, 480);
+    /* Closes the GXBegin(GX_QUADS, 16) twenty-five lines up; anchors to
+     * the closing brace of the 4-iteration loop that emits all sixteen
+     * of its vertices. Immediate mode, not a display list, so Aurora's
+     * general auto-close tolerance kept this from being fatal -- but the
+     * bytes it eventually measured belonged to whatever ran in between,
+     * which is what produced this site's chronic "609 bytes for 16
+     * vertices" warning. Empty inline on hardware (GXVert.h). */
+    GXEnd();
+
+    GXSetTexCopySrc(0, 0, mp6_widescreen_render_width(), 480);
