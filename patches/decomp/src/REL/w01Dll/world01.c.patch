+/* PORT FIX -- float-argument ABI, implicit-declaration class (the class
+ * tools/abi_warning_audit.py exists for; this TU was simply not in its
+ * ABI_CRITICAL_SOURCES set, so it was never audited).
+ *
+ * world01.c calls three functions that NO header it includes declares:
+ *   mbMtxRotAxisRad(Mtx, char, float)   src/board/math.c:157, called at
+ *                                       fn_1_12D58 (the ambient falling-leaf
+ *                                       draw) with particle->angle
+ *   mbHermiteCalcV(HuVecF*, HuVecF*, HuVecF*, HuVecF*, HuVecF*, float)
+ *                                       src/board/math.c:514
+ *   __fabs(double) -> double            MSL, declared only in the
+ *                                       PowerPC_EABI_Support math.h this TU
+ *                                       does not reach
+ * Without a prototype, C's default argument promotions send every `float`
+ * argument as a DOUBLE, and an undeclared function is assumed to return
+ * `int`. On PowerPC EABI that is harmless -- every float argument travels in
+ * f1..f8 as a double anyway and the callee's own frsp narrows it, and
+ * __fabs's result comes back in f1 either way -- which is exactly why the
+ * shipped game never noticed. On x86_64 the caller writes a double into
+ * XMM0 and the callee reads a float32 out of the SAME register, i.e. the
+ * LOW 32 bits of the double's bit pattern.
+ *
+ * That is not "slightly wrong", it is catastrophic and it was visible on
+ * screen: a float widened to double has its low 29 mantissa bits zero, so
+ * the low 32 bits can only ever be one of eight values, and
+ * mbMtxRotAxisRad's angle therefore collapses to one of {0, +/-0.0,
+ * +/-1.084e-19, +/-2.0, +/-3.689e19} regardless of the real angle. Through
+ * board/math.c's cos/sin lookup table those eight collapse to exactly THREE
+ * rotations -- (cos,sin) = (1,0), (-0.416,+0.909), (-0.416,-0.909) -- and
+ * the board's ambient leaves consequently snapped between three fixed poses
+ * from frame to frame instead of fluttering. Measured directly: with
+ * MP6_W01_LEAF_TRACE the integrator's own angle moves at most 8.59 deg per
+ * tick (matching an exact float32 replay of fn_1_1330C), while the drawn
+ * matrix jumped between precisely those three states, and the captured
+ * frames showed the leaf holding one silhouette for 4-6 frames and flipping
+ * to a foreshortened sliver for exactly one -- the long-standing "board
+ * leaf strobe".
+ *
+ * Declaring the three functions here restores the intended (and
+ * PowerPC-observed) behavior; it changes nothing about the decomp's own
+ * code. Kept in this TU rather than in a decomp-overrides header because
+ * world01.c includes none of the headers that would naturally carry them
+ * (game/board/guide.h declares the *Deg* siblings, and this TU does not
+ * include it). */
+void mbMtxRotAxisRad(Mtx m, char axis, float rad);
+void mbHermiteCalcV(HuVecF *a, HuVecF *b, HuVecF *c, HuVecF *d, HuVecF *dst,
+                    float t);
+double __fabs(double x);
+
+/* W01 falling-leaf trace (MP6_W01_LEAF_TRACE=<tick>, 16-tick window).
+ * The board's ambient leaf fall is fn_1_12A4C (spawn, 64 particles) /
+ * fn_1_1330C (per-tick flutter integrator) / fn_1_12D58 (hook-func draw,
+ * one 50x50 XZ-plane quad per particle rotated about Z by particle->angle).
+ * Every flicker report against this board eventually lands on that leaf,
+ * and the ONLY way to tell "the authored angle really moves that far in one
+ * frame" from "the angle is smooth and the DRAW is wrong" is to read the
+ * integrator's own state per tick -- a screen-space silhouette measurement
+ * cannot separate them, because both look like a one-frame pose change.
+ * So: dump angle/angleSpeed/pos/vel for all 64 particles, per tick, for a
+ * short window. Diagnostic only: prints state, never changes behavior; one
+ * cached getenv and zero output when unset. */
+#include <stdio.h>
+#include <stdlib.h>
+extern long mp6_tick_count;
+static long mp6W01LeafTick = -2; /* -2 = env not parsed yet, -1 = disabled */
+static long mp6W01LeafSpan = 16; /* MP6_W01_LEAF_TRACE_TICKS, default 16 */
+static int mp6W01LeafTrace(void)
+{
+    if (mp6W01LeafTick == -2) {
+        const char *e = getenv("MP6_W01_LEAF_TRACE");
+        const char *n = getenv("MP6_W01_LEAF_TRACE_TICKS");
+        mp6W01LeafTick = (e && atol(e) > 0) ? atol(e) : -1;
+        if (n && atol(n) > 0) {
+            mp6W01LeafSpan = atol(n);
+        }
+    }
+    return mp6W01LeafTick > 0 && mp6_tick_count >= mp6W01LeafTick &&
+           mp6_tick_count < mp6W01LeafTick + mp6W01LeafSpan;
+}
+
+/* W01 LAUNCHER-FLOWER isolation levers (diagnostic only -- each is one cached
+ * getenv, and both produce zero output and zero behavior change when unset).
+ *
+ * WHY THESE EXIST: the reported "the flower is extrapolated, it closes in
+ * itself" artifact is fn_1_8860 -- the flower masu the player jumps INTO and
+ * is flung upward out of -- and NOT board/dice.c's DiceObjOMExec bloom, which
+ * is the object every prior lane actually measured. Two separate things made
+ * the real object unmeasurable:
+ *
+ *   MP6_W01_FORCE_FLOWER=1 -- the event fires only when a player STEPS ON one
+ *     of 2 flower spaces out of ~107, so a capture run is a soak, and a soak
+ *     races the board's own GwSystem-corruption wall (docs/history/
+ *     BOARD_PAN_FLOAT_TRAP.md item 6). No soak had ever landed one. This lever
+ *     makes fn_1_760 -- the REAL masu-move-end dispatcher -- install the REAL
+ *     fn_1_8860 hook on the next move end, after pointing the player at the
+ *     real fling space (mAttr 0x00400000 == lbl_1_data_588[0][0]) so that
+ *     fn_1_8860's own workNo lookup resolves to work 0, the day
+ *     swallow+launch branch, exactly as an organic landing does. Nothing here
+ *     calls fn_1_8860 directly: it is a coroutine body (109 HuPrcVSleep
+ *     calls) and MUST run inside the player-move process, which is precisely
+ *     what mbPlayerMoveHookSet arranges.
+ *
+ *   MP6_W01_FLOWER_TRACE=1 -- the flower is driven by an HSF joint motion AND
+ *     a SHAPE (vertex-morph) motion sharing one clock. A screen-space
+ *     silhouette measurement cannot separate "the morph ran and overshot" from
+ *     "the morph never ran at all", so dump the driving state per tick: both
+ *     motion clocks, plus, per MESH object, the exact fields
+ *     game/ShapeExec.c's ShapeProc gates on and SetShapeMain consumes
+ *     (shapeNum / shapeType / baseMorph) alongside the live curr transform.
+ *     That answers the mechanism question directly and reads identically with
+ *     frame interpolation on or off, which a pixel measurement does not. */
+static int mp6W01ForceFlowerV = -1;
+static int mp6W01ForceFlower(void)
+{
+    if (mp6W01ForceFlowerV < 0) {
+        const char *e = getenv("MP6_W01_FORCE_FLOWER");
+        mp6W01ForceFlowerV = (e != NULL && atol(e) > 0) ? 1 : 0;
+    }
+    return mp6W01ForceFlowerV;
+}
+
+static int mp6W01FlowerTraceV = -1;
+static int mp6W01FlowerTrace(void)
+{
+    if (mp6W01FlowerTraceV < 0) {
+        const char *e = getenv("MP6_W01_FLOWER_TRACE");
+        mp6W01FlowerTraceV = (e != NULL && atol(e) > 0) ? 1 : 0;
+    }
+    return mp6W01FlowerTraceV;
+}
+
+/* One line for the model's two motion clocks, then one line per MESH object
+ * carrying the fields the morph path consumes. `phase` names which of
+ * fn_1_8860's two loops the sample came from. Sampled just before this tick's
+ * HuPrcVSleep, i.e. it reports the pose the LAST completed tick evaluated. */
+static void mp6W01FlowerDump(const char *phase, int i, HU3D_MODELID modelId)
+{
+    HU3D_MODEL *modelP;
+    HSF_DATA *hsf;
+    HSF_OBJECT *objP;
+    s16 k;
+
+    if (modelId < 0) {
+        return;
+    }
+    modelP = &Hu3DData[modelId];
+    hsf = modelP->hsf;
+    if (hsf == NULL) {
+        return;
+    }
+    printf("[W01-FLOWER] %s i=%d tick=%ld mot=%.4f spd=%.2f shapeMot=%.4f "
+           "shapeSpd=%.2f hsfShapeNum=%d objectNum=%d\n",
+           phase, i, mp6_tick_count, modelP->motWork.time,
+           modelP->motWork.speed, modelP->motShapeWork.time,
+           modelP->motShapeWork.speed, (int)hsf->shapeNum,
+           (int)hsf->objectNum);
+    objP = hsf->object;
+    for (k = 0; k < hsf->objectNum; k++, objP++) {
+        if (objP->type != HSF_OBJ_MESH) {
+            continue;
+        }
+        printf("[W01-FLOWER]   %s i=%d obj=%s meshShapeNum=%u shapeType=%u "
+               "baseMorph=%.4f sc=%.4f,%.4f,%.4f rot=%.2f,%.2f,%.2f "
+               "tr=%.2f,%.2f,%.2f\n",
+               phase, i, objP->name, (unsigned)objP->mesh.shapeNum,
+               (unsigned)objP->mesh.shapeType, objP->mesh.mesh.baseMorph,
+               objP->mesh.curr.scale.x, objP->mesh.curr.scale.y,
+               objP->mesh.curr.scale.z, objP->mesh.curr.rot.x,
+               objP->mesh.curr.rot.y, objP->mesh.curr.rot.z,
+               objP->mesh.curr.pos.x, objP->mesh.curr.pos.y,
+               objP->mesh.curr.pos.z);
+    }
+    fflush(stdout);
+}
